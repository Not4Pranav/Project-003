{
  "name": "emixfg",
  "version": "2.2.0",
  "description": "EmixFG - Ultimate Discord Bot",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy:guild": "node src/deployCommands.js --guild",
    "deploy:global": "node src/deployCommands.js --global",
    "migrate": "node scripts/migrate.js apply",
    "migrate:check": "node scripts/migrate.js check",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:keys": "node scripts/migrate-keys.js",
    "migrate:keys:dry": "node scripts/migrate-keys.js --dry-run",
    "backup:db": "node scripts/backup.js",
    "restore:db": "node scripts/restore.js",
    "backup:drill": "node scripts/restore-drill.js"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "discord.js": "^14.26.4",
    "dotenv": "^17.2.3",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "riffy": "1.0.12",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "undici": "^6.27.0"
  }
}
