# EmixFG - Environment Configuration
# Copy this to .env and fill in your values

# REQUIRED: Get from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# OPTIONAL: Your server ID for testing
GUILD_ID=your_guild_id_here

# OPTIONAL: Your Discord ID for owner commands
OWNER_IDS=your_discord_id

# OPTIONAL: Command prefix (default: !)
PREFIX=!
