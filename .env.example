# ============================================
# EmixFG - Bot Configuration (Beginner Friendly)
# ============================================
# HOW TO USE:
# 1. Copy this file to .env ->  cp .env.example .env
# 2. Fill ONLY the 2 required values below
# 3. Leave everything else as is - it will just work!
# ============================================

# --- REQUIRED (You MUST fill these 2) ---

# 1. Bot Token - Get from https://discord.com/developers/applications > Your App > Bot > Reset Token > Copy
DISCORD_TOKEN=your_bot_token_here

# 2. Client ID (Application ID) - Get from https://discord.com/developers/applications > Your App > General Information > Application ID > Copy
CLIENT_ID=your_client_id_here

# --- OPTIONAL (Leave as is for beginners) ---

# Your server ID - Right click your server icon > Copy ID (needs Developer Mode ON in Discord Settings > Advanced)
# If you leave it empty, commands will still work globally in all servers (takes up to 1 hour to appear)
GUILD_ID=

# Your Discord User ID - Right click your profile > Copy ID (for owner-only commands)
OWNER_IDS=

# Command prefix for text commands like !ping (default is !)
PREFIX=!
